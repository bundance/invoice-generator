{
  "description": "Repository policy hooks for isolated Git staging and commits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/enforce_isolated_git_writes.py\"",
            "timeout": 5,
            "statusMessage": "Checking Git write isolation"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/enforce_isolated_git_writes.py\"",
            "timeout": 5,
            "statusMessage": "Preventing redundant Git approval prompts"
          }
        ]
      }
    ]
  }
}
