{
  "name": "invoice-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Private, offline macOS invoice generation for Codernetic.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vp dev",
    "test": "vp test run",
    "check:quality": "vp check && react-doctor . --scope full --yes --no-score --no-telemetry --blocking warning && fallow --fail-on-issues --summary",
    "test:electron": "playwright test --project=electron",
    "package:mac": "node --experimental-strip-types --no-warnings src/infrastructure/release-gate/package-mac.ts",
    "inspect:package": "node --experimental-strip-types --no-warnings src/infrastructure/release-gate/inspect-package.ts",
    "check:fallow-plugins": "node --experimental-strip-types --no-warnings src/infrastructure/release-gate/check-fallow-plugins.ts",
    "check:evidence-retention": "node --experimental-strip-types --no-warnings src/infrastructure/release-gate/check-evidence-retention.ts",
    "check:test-policy": "node --experimental-strip-types --no-warnings src/infrastructure/release-gate/check-test-policy.ts",
    "validate": "node --experimental-strip-types --no-warnings src/infrastructure/release-gate/run-release-gate.ts",
    "ui": "shadcn",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@fontsource/arimo": "5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "fflate": "0.8.3",
    "react-hook-form": "^7.86.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.6",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "fallow": "3.22.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.40.0",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-doctor": "0.9.13",
    "react-dom": "19.2.8",
    "shadcn": "4.20.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plugin-electron": "1.1.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@11.25.0",
  "reactDoctor": {
    "ignore": {
      "files": [
        "dist/**",
        "dist-electron/**",
        "release/**"
      ]
    }
  }
}
